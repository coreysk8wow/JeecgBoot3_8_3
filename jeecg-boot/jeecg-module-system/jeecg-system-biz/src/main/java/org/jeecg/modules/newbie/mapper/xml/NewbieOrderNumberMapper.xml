<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.newbie.mapper.NewbieOrderNumberMapper">
    <select id="selectLatestOrderNumberForUpdate"
            parameterType="String"
            resultType="Integer">
        SELECT
            MAX(seq) AS seq
        FROM
            newbie_order_number
        WHERE
            order_date = #{orderDate} AND is_deleted = 0
        FOR UPDATE
    </select>
</mapper>